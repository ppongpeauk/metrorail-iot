# Required for WMATA's GTFS static and GTFS-Realtime endpoints.
WMATA_API_KEY=replace-with-your-wmata-api-key

# Optional: OpenAI-compatible API key used to compact changed GTFS alerts for
# passenger displays. Without it, the app uses the original WMATA alert text.
# OPENAI_API_KEY=replace-with-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional persistent cache for formatted alert text.
# REDIS_URL=redis://default:password@host:6379

# Optional endpoint overrides.
# WMATA_GTFS_STATIC_URL=https://api.wmata.com/gtfs/rail-gtfs-static.zip
# WMATA_GTFS_TRIP_UPDATES_URL=https://api.wmata.com/gtfs/rail-gtfsrt-tripupdates.pb
# WMATA_GTFS_VEHICLE_POSITIONS_URL=https://api.wmata.com/gtfs/rail-gtfsrt-vehiclepositions.pb
# WMATA_GTFS_ALERTS_URL=https://api.wmata.com/gtfs/rail-gtfsrt-alerts.pb
